.geocache.json

# Forward-geocode cache for build-k2k.cjs. City centroids for the NH-44 corridor:
# nothing private in it, but it is Nominatim's answers rather than this project's
# data, and the coordinates that matter are written into k2k.json.
.k2kcache.json
